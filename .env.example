# Copy to .env for Docker Compose. Never commit .env or real API keys.
# Safe defaults: local access only, one application process, statistics off.
OPENNOTELM_BIND_ADDRESS=127.0.0.1
OPENNOTELM_PORT=3000
OPENNOTELM_DATA_DIR=./data
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Optional AFTER the corresponding GitHub release/image has been published.
# Pin a version or digest; leave unset when building locally.
# OPENNOTELM_IMAGE=ghcr.io/daozen/opennotelm:0.1.0-beta.1

# Prefer configuring models in the UI. These optional keys stay on the server.
OPENNOTELM_LANGUAGE_API_KEY=
OPENNOTELM_EMBEDDING_API_KEY=
OPENNOTELM_IMAGE_API_KEY=

# UI-saved settings override these initial defaults. Do not add server workers.
TASK_CONCURRENCY=3
MODEL_REQUEST_CONCURRENCY=8
IMAGE_GENERATION_CONCURRENCY=2
IMAGE_RECOGNITION_CONCURRENCY=4
CONTENT_GENERATION_CONCURRENCY=2

# Optional operator-owned statistics receiver. No sends without a token AND
# explicit user opt-in in Settings. No project receiver is bundled.
TELEMETRY_HOST=https://us.i.posthog.com
TELEMETRY_PROJECT_TOKEN=
